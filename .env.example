# ==============================================================================
# Variables d'environnement pour Books API - Modèle d'exemple
# ==============================================================================
# Copier ce fichier sous le nom .env pour votre environnement local :
#   cp .env.example .env
# Ne JAMAIS commiter le fichier .env contenant des secrets réels.

# Configuration du serveur applicatif
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Configuration de la base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=livres_DB
DB_USER=root
DB_PASSWORD=
